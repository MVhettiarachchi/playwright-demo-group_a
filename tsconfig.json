{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@client/*": ["./src/client/*"],
      "@environment/*": ["./src/environment/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@helper/*": ["./src/helper/*"],
      "@data/*": ["./src/data/*"]
    }
  }
}